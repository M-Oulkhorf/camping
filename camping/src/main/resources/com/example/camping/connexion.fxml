<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<VBox stylesheets="@style.css" fx:id="buttonConnexion" alignment="CENTER" prefHeight="600.0" prefWidth="482.0" spacing="20.0" style="-fx-background-color: #ffffff;" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.camping.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
   <Label text=" PlaniCamp" fx:id="appTitle" alignment="CENTER" />

   <!-- Label en italique et gras avec phrase proposée -->
   <Label text="PlaniCamp, la gestion de vos animations simplifiée." fx:id="italicLabel" alignment="CENTER" />

   <VBox alignment="BOTTOM_CENTER" spacing="10">
      <children>
         <HBox alignment="CENTER" prefHeight="32.0" prefWidth="442.0">
            <children>
               <TextField fx:id="identifiantField" prefHeight="27.0" prefWidth="225.0" promptText="Identifiant" />
            </children>
         </HBox>
         <HBox alignment="CENTER" prefHeight="28.0" prefWidth="442.0">
            <children>
               <PasswordField fx:id="mdpField" prefHeight="28.0" prefWidth="224.0" promptText="Mot de passe" />
            </children>
         </HBox>
         <HBox alignment="BOTTOM_CENTER" prefHeight="0.0" prefWidth="442.0" spacing="10">
            <children>
               <Button fx:id="connexionButton" mnemonicParsing="false" onAction="#handleConnexion"  text="Connexion" textFill="WHITE" />
            </children>
         </HBox>
      </children>
   </VBox>
</VBox>
